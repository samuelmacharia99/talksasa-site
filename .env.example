# Public site URL (marketing site)
NEXT_PUBLIC_SITE_URL=https://talksasa.com

# Talksasa Cloud billing public API (hosting, domains, cloud — not bulk SMS)
BILLING_API_BASE_URL=https://servers.talksasa.com/api/v1/public
BILLING_API_TOKEN=your_api_token_here

# SQLite lead database (created automatically on first request)
DATABASE_PATH=./data/talksasa.db

# Optional: salt for hashing visitor IPs in lead records
IP_HASH_SALT=change-me-to-a-random-string

# Lead API rate limit (requests per IP per 15 minutes)
LEAD_RATE_LIMIT_MAX=8

# Analytics (loaded only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=

# Google Ads conversion tracking (optional)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=xxxxxxxxxx

# Admin leads dashboard (/admin/leads)
LEADS_ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=change-me-to-a-random-32-char-string
