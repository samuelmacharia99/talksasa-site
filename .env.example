# Public site URL (marketing site)
NEXT_PUBLIC_SITE_URL=https://talksasa.com

# Talksasa Cloud billing public API (hosting, domains, cloud — not bulk SMS)
BILLING_API_BASE_URL=https://servers.talksasa.com/api/v1/public
BILLING_API_TOKEN=your_api_token_here

# MySQL database (leads)
# Option A — single URL:
# DATABASE_URL=mysql://talksasa:password@127.0.0.1:3306/talksasa
# Option B — separate vars:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=talksasa
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=talksasa

# Optional: salt for hashing visitor IPs in lead records
IP_HASH_SALT=change-me-to-a-random-string

# Lead API rate limit (requests per IP per 15 minutes)
LEAD_RATE_LIMIT_MAX=8

# Analytics (loaded only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=

# Google Ads conversion tracking (optional)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=xxxxxxxxxx

# Admin leads dashboard (/admin/leads)
LEADS_ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=change-me-to-a-random-32-char-string
ADMIN_ASSIGNEES=Sales Team,Samuel

# SLA — flag new leads not contacted within this many minutes
SLA_WARN_MINUTES=30

# SMTP — instant lead alerts + auto-confirmation emails
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=TalkSasa <sales@talksasa.com>
NOTIFY_EMAIL_TO=sales@talksasa.com
NOTIFY_EMAIL_CC=

# Daily sales digest cron secret (you create this value)
CRON_SECRET=change-me-to-a-random-secret
# Run digest manually (container-safe): npm run cron:digest
# Test SMTP: npm run test:smtp
